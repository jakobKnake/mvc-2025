{% extends "base.html.twig" %}

{% block title %}BlackJack{% endblock %}

{% block body %}
    <div class="relative z-1 grid grid-rows-2 gap-6 min-h-screen bg-[#367A41] border-8 border-solid border-[#340C02] rounded-xl">
        <div class="relative p-4">
            <div class="absolute top-1/2 right-9 transform -translate-y-1/2">
                <div class="relative deck-shadow w-[80px] h-[120px] bg-blue-700 text-white overflow-hidden">
                    <div class="absolute inset-0 flex items-center justify-center mb-4">
                        <span class="text-[120px] scale-[1.1]">{{ cardDown.cardFaceDown() }}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-2 justify-center items-center p-4">
            <form>
            <div class="flex gap-20 flex-wrap justify-evenly">
                {% for hand in player.getHands() %}
                    <div class="flex flex-col justify-center items-center gap-2">
                        <div class="w-24 h-24 border-3 border-gray-100 rounded-full flex items-center justify-center">
                            <span class="text-gray-800">Bet {{ loop.index }}</span>
                        </div>
                        
                            <div class="flex gap-2 flex-wrap justify-center">
                                <label for="hand_{{ loop.index0 }}_5" class="cursor-pointer mb-4 block">
                                    <input type="checkbox" name="hand_{{ loop.index0 }}" value="5" id="hand_{{ loop.index0 }}_5" class="sr-only peer">
                                        <div class="relative bg-cover bg-center bg-no-repeat w-[50px] h-[50px] transition-transform peer-checked:scale-140" 
                                            style="background-image: url('{{ asset('img/proj/pink-mark.png') }}')">

                                            <div class="absolute inset-0 flex items-center justify-center p-3">
                                                <span class="text-white text-xs">(5)</span>
                                            </div>
                                        </div>
                                </label>

                                <label for="hand_{{ loop.index0 }}_10" class="cursor-pointer mb-4 block">
                                    <input type="checkbox" name="hand_{{ loop.index0 }}" value="10" id="hand_{{ loop.index0 }}_10" class="sr-only peer">
                                        <div class="relative bg-cover bg-center bg-no-repeat w-[50px] h-[50px] transition-transform peer-checked:scale-140" 
                                            style="background-image: url('{{ asset('img/proj/blue-marker.png') }}')">

                                            <div class="absolute inset-0 flex items-center justify-center p-3">
                                                <span class="text-white text-xs">(10)</span>
                                            </div>
                                        </div>
                                </label>

                                <label for="hand_{{ loop.index0 }}_25" class="cursor-pointer mb-4 block">
                                    <input type="checkbox" name="hand_{{ loop.index0 }}" value="25" id="hand_{{ loop.index0 }}_25" class="sr-only peer">
                                        <div class="relative bg-cover bg-center bg-no-repeat w-[50px] h-[50px] transition-transform peer-checked:scale-140" 
                                            style="background-image: url('{{ asset('img/proj/red-marker.png') }}')">

                                            <div class="absolute inset-0 flex items-center justify-center p-3">
                                                <span class="text-white text-xs">(25)</span>
                                            </div>
                                        </div>
                                </label>

                                <label for="hand_{{ loop.index0 }}_50" class="cursor-pointer mb-4 block">
                                    <input type="checkbox" name="hand_{{ loop.index0 }}" value="50" id="hand_{{ loop.index0 }}_50" class="sr-only peer">
                                        <div class="relative bg-cover bg-center bg-no-repeat w-[50px] h-[50px] transition-transform peer-checked:scale-140" 
                                            style="background-image: url('{{ asset('img/proj/gold-marker.png') }}')">

                                            <div class="absolute inset-0 flex items-center justify-center p-3">
                                                <span class="text-white text-xs">(50)</span>
                                            </div>
                                        </div>
                                </label>
                            </div>
                    </div>
                {% endfor %}
            </div>
            </form>
        </div>
    </div>

{% endblock %}
