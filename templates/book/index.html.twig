{% extends 'base.html.twig' %}

{% block title %}Bibliotek{% endblock %}

{% block body %}

<div class="text-center">
    <h1>Lilla StadsBibblan</h1>
    <p>Här samlas böcker som är värda att ta en titt på.</p>
    <p>Varsågod och kika runt!</p>

    <div class="flex justify-center items-center gap-4">
        <a class="link-button" href="{{ path('book_show_all') }}">Visa alla böcker</a>
        <a class="link-button" href="{{ path('book_create_get') }}">Lägg till bok</a>
        <a class="link-button" href="{{ path('library_reset') }}">Återställ Bibblan</a>
    </div>
</div>
{% endblock %}
