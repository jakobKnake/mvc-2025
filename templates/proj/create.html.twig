{% extends "proj/base.html.twig" %}

{% block title %}Registrera{% endblock %}

{% block body %}

<div class="mt-3 flex justify-center items-center flex-col">
    <div class="bg-white p-6 flex flex-col justify-center items-center">
        <h1>Välkommen</h1>
        <p>Få den bästa starten med ett av våra välkomsterbjudanden.</p>
        <form action="" method="post" class="bg-white p-6">
            <label for="bonus" class="cursor-pointer mb-4 block">
                <input type="radio" name="bonus_offer" value="bonus" id="bonus" class="sr-only peer">
                    <div class="relative border-2 border-gray-400 bg-cover bg-center bg-no-repeat rounded-md w-64 h-48 peer-checked:border-amber-400" 
                        style="background-image: url('{{ asset('img/proj/bonus.jpg') }}')">

                        <div class="absolute bottom-0 left-0 right-0 p-3" style="background-color: rgba(0, 0, 0, 0.5);">
                            <span class="font-bold text-white text-sm">Vi matchar din första insättning med 100% upp till 1000kr</span>
                        </div>
                    </div>
            </label>

            <label for="bet" class="cursor-not-allowed mb-4 block">
                <input type="radio" name="bonus_offer" value="bet" disabled id="bet" class="sr-only peer">
                    <div class="relative bg-gray-300 opacity-50 border-2 border-gray-400 bg-cover bg-center bg-no-repeat rounded-md w-64 h-48 peer-checked:border-amber-400" 
                        style="background-image: url('{{ asset('img/proj/bet.jpg') }}')">

                        <div class="absolute bottom-0 left-0 right-0 p-3" style="background-color: rgba(0, 0, 0, 0.5);">
                            <span class="font-bold text-white text-sm">Odds Boost! CL-Finalen med ökat odds på båda lagen!</span>
                        </div>
                    </div>
            </label>

            <label for="coins" class="cursor-not-allowed mb-4 block">
                <input type="radio" name="bonus_offer" value="coins" disabled id="coins" class="sr-only peer">
                    <div class="relative bg-gray-300 opacity-50 border-2 border-gray-400 bg-cover bg-center bg-no-repeat rounded-md w-64 h-48 peer-checked:border-amber-400" 
                        style="background-image: url('{{ asset('img/proj/coins.jpg') }}')">

                        <div class="absolute bottom-0 left-0 right-0 p-3" style="background-color: rgba(0, 0, 0, 0.5);">
                            <span class="font-bold text-white text-sm">Få 100kr i FreeSpins på vår slotmaskin <b>Lucky Casino</b></span>
                        </div>
                    </div>
            </label>

            <label for="nothing">
                <input type="radio" name="bonus_offer" value="nothing" id="nothing">
                Inget erbjudande
            </label>

            <label class="font-bold block mt-2" for="user_name">Användarnamn:</label>
            <input class="border-2 rounded-sm border-black py-[0.6rem] px-[0.6rem]" id="user_name" required type="text" name="username">
            <label class="font-bold block mt-2" for="user_password">Lösenord:</label>
            <input class="border-2 rounded-sm border-black py-[0.6rem] px-[0.6rem]" type="password" required id="user_password" name="password">
            <input class="bg-[#147B45] text-white border-2 rounded-sm border-black 
            py-[0.6rem] px-[0.6rem] hover:bg-[#0f5e35] block mt-3" type="submit" value="Skapa Konto">
        </form>
    </div>
</div>



{% endblock %}