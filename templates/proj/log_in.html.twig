{% extends "proj/base.html.twig" %}

{% block title %}Logga In{% endblock %}

{% block body %}
<div class="mt-3 flex justify-center items-center flex-col">
    <h1>Logga In</h1>
    <form class="bg-white rounded-md p-6" action="" method="post">
        <label class="font-bold block mt-2" for="user_name">Användarnamn:</label>
        <input class="border-2 rounded-sm border-black py-[0.6rem] px-[0.6rem]" id="user_name" required type="text" name="username">
        <label class="font-bold block mt-2" for="user_password">Lösenord:</label>
        <input class="border-2 rounded-sm border-black py-[0.6rem] px-[0.6rem]" type="password" required id="user_password" name="password">
        <input class="bg-[#147B45] text-white border-2 rounded-sm border-black 
            py-[0.6rem] px-[0.6rem] hover:bg-[#0f5e35]" type="submit" value="Logga in">
    </form>
    <div class="mt-3 text-center">
        Har du inget konto än?
        <a class="bg-[#FFE71F] inline-block py-1.5 px-4 rounded-sm cursor-pointer text-black 
        font-medium text-sm whitespace-nowrap transition hover:bg-[#F0CD0E] block mt-3" href="{{ path('create_user') }}">Skapa Konto</a>
    </div>
</div>
{% endblock %}