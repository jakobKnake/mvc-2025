{% extends 'base.html.twig' %}

{% block title %}Bibliotek{% endblock %}

{% block body %}

<div class="mt-3 flex flex-col items-center justify-center">
    <h1 class="text-center">Lilla StadsBibblan</h1>
    <p class="text-center">Här visas våra böcker. Klicka på boken för att se detaljer.</p>

    <ul>
        {% for book in books %}
            <li class="mt-2 font-bold"><a href="{{ path('book_by_id', {'id': book.getId()}) }}">{{ book.getTitle() }}</a></li>
        {% endfor %}
    </ul>

    <div class="flex justify-center items-center mt-4">
        <a class="link-button" href="{{ path('book_create_get') }}">Lägg till bok</a>
    </div>
</div>
{% endblock %}
