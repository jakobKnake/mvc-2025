{% extends "base.html.twig" %}

{% block title %}Black Jack{% endblock %}

{% block body %}
{% if app.session.get('logged_in') and app.session.get('user') %}
    {% set user = app.session.get('user') %}
    <div class="p-6 text-white bg-cover bg-center h-screen flex flex-col items-center" 
        style="background-image: url('{{ asset('img/proj/bakgrundspel.jpg') }}')">
    <div class="glass-btn p-8 text-center text-shadow-lg/60">
        <h1>Välkommen till Black Jack bordet!</h1>
        <p class="!text-white !text-xs">Minimum insats 5kr</p>
        <p class="!text-white">Hur många händer vill du spela?</p>
        <form method="post" action="{{ path('proj_init_post') }}">
            <input class="border border-black border-solid p-4" type="text" name="name" readonly value="{{ user.getUsername }}">
            <input class="border border-black border-solid p-4" type="number" required min="1" max="3" name="hands">
            <input class="inline-block py-2.5 px-5 rounded-lg bg-white text-black 
                font-bold text-xl hover:text-red-600 transition-colors duration-300 text-center w-40" type="submit" name="do_it" value="Start playing">
        </form>
    </div>
</div>

{% else %}
    <div class="bg-cover bg-center min-h-screen flex flex-col justify-center items-center" style="background-image: url('{{ asset('img/game/blackjack.jpg') }}');">
        <div class="glass-btn p-8 text-center">
            <h1>Välkommen till Black Jack bordet!</h1>
            <p class="!text-black">Single-player Black Jack. Skriv in ditt namn ock kör!</p>
            <form method="post" action="">
                <input class="border border-black border-solid p-4" type="text" name="name" required>
                <input class="inline-block py-2.5 px-5 rounded-lg bg-white text-black 
            font-bold text-xl hover:text-red-600 transition-colors duration-300 text-center w-40" type="submit" name="do_it" value="Start playing">
            </form>
        </div>     
    </div>
{% endif %}

{% endblock %}